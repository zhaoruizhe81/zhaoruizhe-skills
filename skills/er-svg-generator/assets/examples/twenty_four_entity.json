    { "id": "customer", "label": "客户", "layout": { "priority": 95, "attributes": { "mode": "radial", "side": "left" } }, "attributes": [ { "id": "customer_id", "label": "客户编号", "key": true }, { "id": "name", "label": "姓名" }, { "id": "phone", "label": "电话" } ] },
    { "id": "member", "label": "会员", "layout": { "priority": 65, "attributes": { "mode": "radial", "side": "left" } }, "attributes": [ { "id": "member_id", "label": "会员编号", "key": true }, { "id": "level", "label": "等级" }, { "id": "points", "label": "积分" } ] },
