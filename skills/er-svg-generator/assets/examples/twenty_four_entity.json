{
  "title": "二十四实体压力测试 ER 图",
  "layout": {
    "mode": "greedy",
    "center": "order",
    "spacing": { "x": 360, "y": 280 },
    "postLayout": "arrange",
    "targetAspect": 1.6,
    "territory": {
      "safeGap": 120,
      "attributePadding": 36,
      "portLane": 52
    }
  },
  "entities": [
